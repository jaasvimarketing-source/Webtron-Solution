# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Privacy-Focused Analytics (Plausible / Umami / Custom Beacon)
# Leave blank to run only the built-in zero-cookie client event dispatcher.
# VITE_ANALYTICS_PROVIDER="plausible"
# VITE_ANALYTICS_SCRIPT_URL="https://plausible.io/js/script.tagged-events.js"
# VITE_ANALYTICS_DOMAIN="your-domain.com"
# VITE_ANALYTICS_WEBSITE_ID=""
# VITE_ANALYTICS_ENDPOINT=""
# Optional Google Ads Conversion ID/Label for preview modal opens (e.g. "AW-123456789/AbC-dEfGhIj")
# VITE_GOOGLE_ADS_CONVERSION_TO=""

# Server-Side Automated WhatsApp Lead Delivery (choose any one provider)
# Target business WhatsApp number (digits with country code, defaults to 918910964232)
WHATSAPP_RECIPIENT_NUMBER="918910964232"

# Option 1: Automation Webhook (Make, Zapier, n8n, Pabbly, or custom WhatsApp gateway)
# WHATSAPP_WEBHOOK_URL=""
# WHATSAPP_WEBHOOK_SECRET=""

# Option 2: Meta WhatsApp Cloud API
# WHATSAPP_CLOUD_ACCESS_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_TEMPLATE_NAME=""
# WHATSAPP_TEMPLATE_LANG="en_US"

# Option 3: Twilio WhatsApp API
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"

# Option 4: CallMeBot Personal WhatsApp API (quickest free personal setup)
# WHATSAPP_CALLMEBOT_APIKEY=""

# Agency Owner Google email permitted to inspect saved server leads
# ADMIN_EMAIL="jaasvi.marketing@gmail.com"
